<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- SEO Básico -->
    <title>Tsuchiya Tech | Sites, Sistemas e Automação com IA</title>
    <meta name="description" content="Elimine processos lentos e ganhe visibilidade. Automação de processos com IA, sistemas sob medida e sites de alta performance para sua empresa em Sorocaba.">
    
    <!-- Tipografia Brutalista/Editorial -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Ícones (Lucide) -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['"Space Grotesk"', 'sans-serif'] },
                    colors: {
                        bg: '#EBE8E3',    // Off-white estilo Odin's Crow
                        black: '#1A1A1A', // Preto denso
                        brand: '#FF4A00', // Acento de cor (opcional para hover)
                    }
                }
            }
        }
    </script>

    <style>
        body { 
            background-color: theme('colors.bg'); 
            color: theme('colors.black'); 
        }
        
        /* Sistema de Bordas Rigoroso */
        .brutal-border { border: 1px solid theme('colors.black'); }
        .brutal-border-b { border-bottom: 1px solid theme('colors.black'); }
        .brutal-border-t { border-top: 1px solid theme('colors.black'); }
        .brutal-border-l { border-left: 1px solid theme('colors.black'); }
        .brutal-border-r { border-right: 1px solid theme('colors.black'); }
        
        /* Animação Fade-Up Padrão */
        .fade-up { opacity: 0; transform: translateY(20px); transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
        .fade-up.visible { opacity: 1; transform: translateY(0); }
        
        /* Interações */
        .hover-invert:hover { background-color: theme('colors.black'); color: theme('colors.bg'); }
        .hover-invert-reverse:hover { background-color: theme('colors.bg'); color: theme('colors.black'); }
    </style>
</head>
<body class="font-sans antialiased selection:bg-black selection:text-bg">

